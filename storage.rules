rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /profile_pictures/{userId}.jpg {
      allow write: if request.auth != null && request.auth.uid == userId;
      allow read: if true;
    }
    match /book_covers/{allPaths=**} {
      allow write: if request.auth != null;
      allow read: if true;
    }
  }
}
